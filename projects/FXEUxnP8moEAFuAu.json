          {
            "type": "text",
            "id": "8cc2e663-cd61-40bd-87f4-a9f87485ece3",
            "text": {
              "ops": [
                {
                  "insert": "Security boundary and scale decision",
                  "attributes": {}
                },
                {
                  "insert": "\n",
                  "attributes": {
                    "paragraph": true
                  }
                }
              ]
            },
            "format": {
              "node": "h1",
              "children": null
            },
            "collapsed": false,
            "completed": false,
            "children": [
              {
                "type": "text",
                "id": "1cb407e0-79bb-46bd-9733-0adcd4b08bb2",
                "text": {
                  "ops": [
                    {
                      "insert": "Taskade-native architecture is suitable for managed pilots and dedicated customer deployments. Fine-grained secure role access to shared writable tenant data is the principal gap.",
                      "attributes": {}
                    },
                    {
                      "insert": "\n",
                      "attributes": {
                        "paragraph": true
                      }
                    }
                  ]
                },
                "format": {
                  "node": "bullet",
                  "children": null
                },
                "collapsed": false,
                "completed": false,
                "children": []
              },
              {
                "type": "text",
                "id": "2be03f39-678e-48af-a6e3-7d313d754223",
                "text": {
                  "ops": [
                    {
                      "insert": "Before broad self-serve scale, choose between constrained Taskade-native access patterns and an external policy/data service for organisation membership, role enforcement, tenant-wide shared writes, billing webhooks and automated provisioning.",
                      "attributes": {}
                    },
                    {
                      "insert": "\n",
                      "attributes": {
                        "paragraph": true
                      }
                    }
                  ]
                },
                "format": {
                  "node": "bullet",
                  "children": null
                },
                "collapsed": false,
                "completed": false,
                "children": []
              }
            ]
          }
        ]
      }
    ]
