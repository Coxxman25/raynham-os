        "children": [
          {
            "type": "text",
            "id": "186f9a55-3c5f-47d2-b16d-265346a65938",
            "text": {
              "ops": [
                {
                  "insert": "Direction and purpose",
                  "attributes": {}
                },
                {
                  "insert": "\n",
                  "attributes": {
                    "paragraph": true
                  }
                }
              ]
