    {
      "name": "d4a5b6c7-e8f9-0123-defa-123456789012",
      "valid": false,
      "displayName": "Write Evidence Entry — Submitted",
      "type": "PIECE",
      "settings": {
        "pieceName": "@taskade/automade-internalpiece-taskade",
        "pieceVersion": "BLANK",
