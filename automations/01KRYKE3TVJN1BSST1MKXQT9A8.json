            },
            "@epDT": {
              "data": {
                "value": "{{ a1f2e3d4-b5c6-7890-abcd-ef0123456789[\"summary\"] }} GPS: {{ trigger[\"body\"][\"latitude\"] }},{{ trigger[\"body\"][\"longitude\"] }}."
              },
              "rank": "2",
