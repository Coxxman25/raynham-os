          },
          "content": "Observation submitted via {{ trigger[\"body\"][\"anchorColor\"] }} portal. Zone: {{ trigger[\"body\"][\"locationCode\"] }}. AI: {{ a1f2e3d4-b5c6-7890-abcd-ef0123456789[\"severity\"] }} / {{ a1f2e3d4-b5c6-7890-abcd-ef0123456789[\"category\"] }}. SLA clock started.",
          "position": "afterbegin",
          "projectId": {
            "type": "flow-template-variable-input-type",
            "id": "PdW5aV2A9UJJjoXh"
          }
        }
